{
  "name": "enigma-lab",
  "version": "0.6.0",
  "private": true,
  "description": "A static, offline-capable Enigma simulator: WebGPU with an SVG fallback, mobile first, driven by @enigma-lab/core.",
  "license": "MIT",
  "author": "Priyanshu Raj <243560345+indpriyanshuraj@users.noreply.github.com>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lib": "node scripts/fetch-lib.mjs",
    "dev": "node scripts/fetch-lib.mjs && vite",
    "build": "node scripts/fetch-lib.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "packageManager": "pnpm@10.20.0"
}
